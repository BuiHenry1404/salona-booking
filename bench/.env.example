# Cấu hình benchmark — copy thành bench/.env rồi điền giá trị thật.
# Chỉ file này được đọc (bench/config.py tự parse, KHÔNG dùng python-dotenv,
# KHÔNG đọc biến môi trường shell). Thiếu khoá nào thì dùng giá trị mặc định
# trong bench/config.py.

# Model dùng cho judge và khách giả lập (qua AnthropicFoundry). Mặc định claude-sonnet-4-6.
BENCH_JUDGE_MODEL=claude-sonnet-4-6

# Thông tin Azure AI Foundry / Anthropic Foundry resource để gọi model trên.
BENCH_FOUNDRY_RESOURCE=
BENCH_FOUNDRY_API_KEY=

# Cổng bắt đầu cấp cho mỗi ref server (mỗi ref 1 worker uvicorn, cổng riêng).
BENCH_BASE_PORT=8100

# Mongo dùng để kiểm tra kết quả (đọc trực tiếp, không qua app).
BENCH_MONGO_URI=mongodb://localhost:27017

# Langfuse (tuỳ chọn) — để trống hoặc comment dòng nếu không dùng.
BENCH_LANGFUSE_HOST=
BENCH_LANGFUSE_PUBLIC_KEY=
BENCH_LANGFUSE_SECRET_KEY=

# Tài khoản admin dùng để thiết lập giờ tiệm/seed dữ liệu trước mỗi lần chạy.
BENCH_ADMIN_PHONE=0901234567
BENCH_ADMIN_PASSWORD=chutiem123

# Số giây tối đa chờ 1 lượt chat trước khi ghi "timeout".
BENCH_TURN_TIMEOUT_S=120.0
