# ================================
# Required configuration
# ================================
# These must be provided for the app to start
#
# Chỉ file này (và .env.docker trong container) được đọc — biến môi trường của
# shell bị bỏ qua, xem app/core/config.py.

# Example: mongodb://localhost:27017
MONGO_URI=

# A strong random string
JWT_SECRET=

# API key used by the app (feature/endpoint protection)
API_KEY=


# ================================
# Default configuration (override if needed)
# ================================
# Application
APP_NAME=chatbot-api
ENV=dev
DEBUG=false

# Database
MONGO_DB_NAME=chatbot_db

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Refresh token sống bao lâu. Access token vẫn ngắn (JWT_EXPIRE_MINUTES);
# client đổi refresh token lấy access token mới nên khách không phải đăng nhập lại.
REFRESH_TOKEN_DAYS=30
# Refresh token nằm trong cookie HttpOnly, KHÔNG trả trong body — body là buộc
# frontend cất ở nơi JavaScript đọc được, một lỗ XSS là mất sạch phiên khách.
# Đặt true khi đã có HTTPS. Để false thì cookie đi qua http:// được, chỉ dùng cho dev.
COOKIE_SECURE=true

# Đăng nhập sai quá số lần này trong cửa sổ thời gian thì khoá tạm,
# đếm theo cả SĐT lẫn IP. Test đặt ngưỡng cao hơn để không đỏ vì 429.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# CORS (comma-separated list will be parsed)
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# LLM provider selection: azure | openai | openai_compatible | anthropic | gemini
LLM_PROVIDER=azure

# Azure OpenAI (set if LLM_PROVIDER=azure)
# Thiếu KEY hoặc ENDPOINT: app vẫn chạy nhưng mọi lượt chat trả về `error`.
# ENDPOINT là URL gốc, không kèm /openai/v1. DEPLOYMENT là tên deployment,
# không phải tên model — sai một trong hai là Azure trả 404.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_MODEL=gpt-4.1-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# OpenAI (set if LLM_PROVIDER=openai)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# OpenAI-compatible (set if LLM_PROVIDER=openai_compatible)
# Trỏ tới BẤT KỲ endpoint nào nói giao thức OpenAI: gateway tự dựng, nhà cung
# cấp khác, hoặc gateway chạy local (ví dụ một router/LLM gateway trên máy).
# Luồng chat, tool calling và streaming đều đi qua endpoint này.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=your-model-name

# Anthropic (set if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini (set if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Booking
BOOKING_SLOT_MINUTES=60
# Số lịch tối đa một khách đặt được trong một giờ — chống spam.
BOOKING_MAX_PER_HOUR=20
# Số tin nhắn chat tối đa một khách gửi trong một giờ — trần chi phí LLM.
# Mỗi lượt chạy ít nhất 2 lượt gọi model. Một cuộc đặt lịch thật hết 5-15 tin.
# Bỏ trống thì dùng mặc định 30.
CHAT_MAX_PER_HOUR=30
TIMEZONE=Asia/Ho_Chi_Minh

# SĐT tiệm — hiện cho khách khi máy chủ hỏng. Điền số thật trước khi lên production.
SHOP_PHONE=

# Khoá tuỳ chọn phải để nguyên dạng comment, ĐỪNG gán chuỗi rỗng: `KEY=` cho ra
# "" chứ không phải None, và code phân biệt hai thứ đó ("chưa cấu hình" là một
# trạng thái thật).

# Langfuse — để nguyên comment thì tắt trace
# Tự dựng: docker compose -f docker-compose.langfuse.yml up -d → localhost:3100
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram — để nguyên comment thì không chạy bot
# TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
