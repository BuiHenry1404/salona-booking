# Chỉ những khoá KHÁC với .env khi chạy trong container. File này được mount
# vào /run/config/env.docker và đọc SAU .env, nên nó thắng — mọi khoá không có
# ở đây vẫn lấy từ .env.
#
# Đừng chép cả .env vào đây: hai bản đầy đủ là hai bản lệch nhau sau vài tuần.

# Trong mạng của compose, Mongo tên là "mongo", không phải localhost.
MONGO_URI=mongodb://mongo:27017
